{
  "name": "clinicas",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @clinicas/api test",
    "db:migrate": "pnpm --filter @clinicas/api db:migrate",
    "db:generate": "pnpm --filter @clinicas/api db:generate"
  },
  "devDependencies": { "turbo": "2.11.13" }
}
