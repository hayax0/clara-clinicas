{
  "name": "@clinicas/api",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && tsc-watch --onSuccess 'node dist/main.js'",
    "start": "node dist/main.js",
    "build": "pnpm db:generate && tsc",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --test test/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:promote": "node dist/promote-admin.js",
    "admin:create": "node dist/create-admin.js",
    "ai:smoke": "node dist/ai/smoke.js"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@clinicas/ai-core": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "type": "module"
}
