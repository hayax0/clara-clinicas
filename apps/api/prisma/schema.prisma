generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

enum OpportunityStage {
  NEW
  CONTACTED
  BOOKED
  WON
  LOST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  OPEN
  DONE
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum FinanceEntryStatus {
  PENDING
  PAID
  CANCELLED
}

enum FinancePaymentMethod {
  CASH
  PIX
  CARD
  TRANSFER
  OTHER
}

enum CashClosingStatus {
  CLOSED
  REOPENED
}

enum PatientPackageStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  marketingCampaigns MarketingCampaign[]
  inboxAssignments InboxThread[]
  financeEntriesCreated FinanceEntry[] @relation("FinanceEntryCreatedBy")
  financeEntriesSettled FinanceEntry[] @relation("FinanceEntrySettledBy")
  financeEntriesReconciled FinanceEntry[] @relation("FinanceEntryReconciledBy")
  cashClosingsClosed CashClosing[] @relation("CashClosingClosedBy")
  cashClosingsReopened CashClosing[] @relation("CashClosingReopenedBy")
  patientPackagesCreated PatientPackage[] @relation("PatientPackageCreatedBy")
  packageUsagesRecorded PackageSessionUsage[] @relation("PackageUsageRecordedBy")
  packageUsagesReverted PackageSessionUsage[] @relation("PackageUsageRevertedBy")
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  isAdmin      Boolean      @default(false)
  uiLocale     String?
  createdAt    DateTime     @default(now()) @db.Timestamptz
  sessions     Session[]
  memberships  Membership[]
  assistantTurns AssistantTurn[]
  assistantNotes AssistantNote[]
}

model Session {
  digest    String   @id
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  marketingCampaigns MarketingCampaign[]
  financeCategories FinanceCategory[]
  financeEntries FinanceEntry[]
  cashClosings CashClosing[]
  servicePackages ServicePackage[]
  patientPackages PatientPackage[]
  packageSessionUsages PackageSessionUsage[]
  capturePage Json?
  inboxThreads InboxThread[]
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  countryCode   String             @default("BR")
  timezone      String             @default("America/Sao_Paulo")
  currency      String             @default("BRL")
  locale        String             @default("pt-BR")
  status        OrganizationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @db.Timestamptz
  memberships   Membership[]
  units         Unit[]
  services      Service[]
  professionals Professional[]
  contacts      Contact[]
  patients      Patient[]
  opportunities Opportunity[]
  appointments  Appointment[]
  tasks         Task[]
  auditEvents   AuditEvent[]
  aiExecutions  AiExecution[]
  assistantTurns AssistantTurn[]
  assistantNotes AssistantNote[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Unit {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  name           String
  address        String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]

  @@unique([organizationId, id])
}

model Service {
  id              String        @id @db.Uuid
  organizationId  String        @db.Uuid
  name            String
  durationMinutes Int
  priceCents      Int
  createdAt       DateTime      @default(now()) @db.Timestamptz
  organization    Organization  @relation(fields: [organizationId], references: [id])
  appointments    Appointment[]
  servicePackages ServicePackage[]

  @@unique([organizationId, id])
}

model Professional {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  name           String
  specialty      String?
  email          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]
  financeEntries FinanceEntry[]
  patientPackages PatientPackage[]

  @@unique([organizationId, id])
}

model Contact {
  marketingConsentAt DateTime? @db.Timestamptz
  marketingRevokedAt DateTime? @db.Timestamptz
  leadStatus String @default("NEW")
  followUpAt DateTime? @db.Timestamptz
  captureRequestId String? @db.Uuid
  @@unique([organizationId, captureRequestId])
  source String?
  inboxThreads InboxThread[]
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  name           String
  email          String?
  phone          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  opportunities  Opportunity[]

  @@unique([organizationId, id])
}

model Patient {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  name           String
  email          String?
  phone          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]
  financeEntries FinanceEntry[]
  patientPackages PatientPackage[]

  @@unique([organizationId, id])
}

model Opportunity {
  id             String           @id @db.Uuid
  organizationId String           @db.Uuid
  title          String
  contactId      String           @db.Uuid
  stage          OpportunityStage @default(NEW)
  createdAt      DateTime         @default(now()) @db.Timestamptz
  organization   Organization     @relation(fields: [organizationId], references: [id])
  contact        Contact          @relation(fields: [organizationId, contactId], references: [organizationId, id])

  @@index([organizationId, contactId])
}

model Appointment {
  reminderPhone String?
  reminders AppointmentReminder[]
  id             String            @id @db.Uuid
  organizationId String            @db.Uuid
  patientId      String            @db.Uuid
  professionalId String            @db.Uuid
  serviceId      String            @db.Uuid
  unitId         String            @db.Uuid
  startAt        DateTime          @db.Timestamptz
  endAt          DateTime          @db.Timestamptz
  status         AppointmentStatus @default(SCHEDULED)
  createdAt      DateTime          @default(now()) @db.Timestamptz
  organization   Organization      @relation(fields: [organizationId], references: [id])
  patient        Patient           @relation(fields: [organizationId, patientId], references: [organizationId, id])
  professional   Professional      @relation(fields: [organizationId, professionalId], references: [organizationId, id])
  service        Service           @relation(fields: [organizationId, serviceId], references: [organizationId, id])
  unit           Unit              @relation(fields: [organizationId, unitId], references: [organizationId, id])
  packageUsages  PackageSessionUsage[]

  @@unique([organizationId, id])
  @@index([organizationId, startAt])
  @@index([organizationId, patientId])
  @@index([organizationId, professionalId])
  @@index([organizationId, serviceId])
  @@index([organizationId, unitId])
}

model Task {
  id             String       @id @db.Uuid
  organizationId String       @db.Uuid
  title          String
  status         TaskStatus   @default(OPEN)
  dueAt          DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  action         String
  resourceId     String?
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

enum AiExecutionStatus {
  RESERVED
  COMPLETED
  FAILED
  BLOCKED
}

model AiExecution {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  actorId            String            @db.Uuid
  agentId            String
  tool               String?
  status             AiExecutionStatus @default(RESERVED)
  quotaDay           DateTime          @db.Date
  reservedCalls      Int
  reservedTokens     Int
  accountedCalls     Int
  accountedTokens    Int
  attempts           Int?
  modelId            String?
  latencyMs          Int?
  inputTokens        Int?
  outputTokens       Int?
  thinkingTokens     Int?
  cachedInputTokens  Int?
  estimatedCostUsd   Decimal?          @db.Decimal(18, 10)
  createdAt          DateTime          @default(now()) @db.Timestamptz
  finishedAt         DateTime?         @db.Timestamptz
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, quotaDay])
  @@index([organizationId, actorId, createdAt])
}

model AssistantTurn {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  agentId        String
  requestId      String       @db.Uuid
  userText       String       @db.VarChar(320)
  answer         String?
  responderId    String?
  tool           String?
  metrics        Json?
  actionDraft    Json?
  proposalTitle  String?      @db.VarChar(120)
  proposalExpiresAt DateTime? @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actorId, agentId, requestId])
  @@index([organizationId, actorId, agentId, createdAt])
}

model AssistantNote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  note           String       @db.VarChar(280)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actorId, note])
  @@index([organizationId, actorId, createdAt])
}

model InboxThread {
  waPhone String?
  waPeer String?
  waLastInbound DateTime? @db.Timestamptz
  @@unique([organizationId,waPhone,waPeer])
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId String? @db.Uuid
  contact Contact? @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  assigneeId String? @db.Uuid
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  subject String
  closed Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz
  events InboxEvent[]
  @@index([organizationId, updatedAt])
}

model InboxEvent {
  externalId String? @unique
  delivery String?
  id String @id @default(uuid()) @db.Uuid
  threadId String @db.Uuid
  thread InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  version Int
  actor String
  actorId String? @db.Uuid
  text String
  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([threadId, version])
}

model AppointmentReminder {
  id String @id @default(uuid()) @db.Uuid
  appointmentId String @db.Uuid
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId String @db.Uuid
  startAt DateTime @db.Timestamptz
  peer String
  phoneId String
  state String @default("pending")
  externalId String? @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([appointmentId, patientId, startAt, peer])
  @@index([phoneId, peer])
}

model MarketingCampaign {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdById String @db.Uuid
  createdBy User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  name String
  source String?
  objective String
  message String
  createdAt DateTime @default(now()) @db.Timestamptz
  recipients MarketingCampaignRecipient[]
  @@index([organizationId,createdAt])
}

model MarketingCampaignRecipient {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campaign MarketingCampaign @relation(fields:[campaignId],references:[id],onDelete:Cascade)
  contactId String @db.Uuid
  contactName String
  phone String
  status String @default("PENDING")
  sentAt DateTime? @db.Timestamptz
  sentById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([campaignId,contactId])
  @@index([campaignId,status])
}

model FinanceCategory {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(80)
  type           FinanceType
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        FinanceEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, type, name])
  @@index([organizationId, type])
}

model FinanceEntry {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  type           FinanceType
  status         FinanceEntryStatus    @default(PENDING)
  description    String                @db.VarChar(160)
  amountCents    Int
  dueDate        DateTime              @db.Date
  settledDate    DateTime?             @db.Date
  settledAt      DateTime?             @db.Timestamptz
  settledById    String?               @db.Uuid
  paymentMethod  FinancePaymentMethod?
  categoryId     String?               @db.Uuid
  patientId      String?               @db.Uuid
  professionalId String?               @db.Uuid
  notes          String?               @db.VarChar(300)
  reconciledAt   DateTime?             @db.Timestamptz
  reconciledById String?               @db.Uuid
  createdById    String                @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz
  updatedAt      DateTime              @updatedAt @db.Timestamptz
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       FinanceCategory?      @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  patient        Patient?              @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  professional   Professional?         @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Restrict)
  createdBy      User                  @relation("FinanceEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  settledBy      User?                 @relation("FinanceEntrySettledBy", fields: [settledById], references: [id], onDelete: Restrict)
  reconciledBy   User?                 @relation("FinanceEntryReconciledBy", fields: [reconciledById], references: [id], onDelete: Restrict)
  patientPackages PatientPackage[]

  @@unique([organizationId, id])
  @@index([organizationId, dueDate])
  @@index([organizationId, settledDate])
  @@index([organizationId, status])
}

model CashClosing {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  closingDate     DateTime          @db.Date
  status          CashClosingStatus @default(CLOSED)
  receivedCents   Int
  paidCents       Int
  netCents        Int
  reconciledCount Int
  notes           String?           @db.VarChar(300)
  closedById      String            @db.Uuid
  closedAt        DateTime          @default(now()) @db.Timestamptz
  reopenedById    String?           @db.Uuid
  reopenedAt      DateTime?         @db.Timestamptz
  reopenReason    String?           @db.VarChar(280)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closedBy        User              @relation("CashClosingClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy      User?             @relation("CashClosingReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, closingDate])
  @@index([organizationId, closingDate])
}

model ServicePackage {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String           @db.VarChar(120)
  serviceId      String?          @db.Uuid
  totalSessions  Int
  priceCents     Int
  validityDays   Int?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamptz
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service?         @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)
  assignments    PatientPackage[]

  @@unique([organizationId, id])
  @@index([organizationId, active])
}

model PatientPackage {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  patientId      String                @db.Uuid
  packageId      String                @db.Uuid
  professionalId String?               @db.Uuid
  financeEntryId String?               @db.Uuid
  totalSessions  Int
  usedSessions   Int                   @default(0)
  priceCents     Int
  status         PatientPackageStatus  @default(ACTIVE)
  purchasedAt    DateTime              @db.Date
  expiresAt      DateTime?             @db.Date
  notes          String?               @db.VarChar(300)
  createdById    String                @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz
  updatedAt      DateTime              @updatedAt @db.Timestamptz
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient               @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  servicePackage ServicePackage        @relation(fields: [organizationId, packageId], references: [organizationId, id], onDelete: Restrict)
  professional   Professional?         @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Restrict)
  financeEntry   FinanceEntry?         @relation(fields: [organizationId, financeEntryId], references: [organizationId, id], onDelete: SetNull)
  createdBy      User                  @relation("PatientPackageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usages         PackageSessionUsage[]

  @@unique([organizationId, id])
  @@index([organizationId, patientId])
  @@index([organizationId, status])
}

model PackageSessionUsage {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  patientPackageId String         @db.Uuid
  appointmentId    String?        @db.Uuid
  usedAt           DateTime       @default(now()) @db.Timestamptz
  notes            String?        @db.VarChar(240)
  recordedById     String         @db.Uuid
  revertedAt       DateTime?      @db.Timestamptz
  revertedById     String?        @db.Uuid
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientPackage   PatientPackage @relation(fields: [organizationId, patientPackageId], references: [organizationId, id], onDelete: Cascade)
  appointment      Appointment?   @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: SetNull)
  recordedBy       User           @relation("PackageUsageRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  revertedBy       User?          @relation("PackageUsageRevertedBy", fields: [revertedById], references: [id], onDelete: Restrict)

  @@index([organizationId, patientPackageId])
  @@index([organizationId, appointmentId])
}

